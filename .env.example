# This is added automatically when you connect a Postgres database
# (via the Neon integration in the Vercel Marketplace) to this project.
# You do not need to set it by hand in production.
DATABASE_URL=

# Set these yourself in Vercel > Project > Settings > Environment Variables.

# The password registrar staff will type in to reach the dashboard.
REGISTRAR_PASSWORD=change-this-password

# A random long string used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-string
